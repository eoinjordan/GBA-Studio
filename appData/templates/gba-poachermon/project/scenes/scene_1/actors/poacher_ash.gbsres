        { "id": "ash-arrest", "command": "EVENT_TEXT", "args": { "text": "CAUGHT: POACHER ASH\nReported for safe collection." } },
        { "id": "ash-set", "command": "EVENT_SET_VALUE", "args": { "variable": "11", "value": { "type": "true" } } },
        { "id": "ash-inc", "command": "EVENT_INC_VALUE", "args": { "variable": "2" } },
        { "id": "ash-collisions", "command": "EVENT_ACTOR_COLLISIONS_DISABLE", "args": { "actorId": "$self$" } },
        { "id": "ash-step", "command": "EVENT_ACTOR_MOVE_RELATIVE", "args": { "actorId": "$self$", "x": { "type": "number", "value": -1 }, "y": { "type": "number", "value": 0 } } },
        { "id": "ash-wait", "command": "EVENT_WAIT", "args": { "frames": 8 } },
        { "id": "ash-hide", "command": "EVENT_ACTOR_DEACTIVATE", "args": { "actorId": "$self$" } },
        { "id": "ash-reset-tone", "command": "EVENT_PALETTE_SET_BACKGROUND", "args": { "tone": 0 } }
      ], "false": [ { "id": "ash-no-proof", "command": "EVENT_TEXT", "args": { "text": "Ash: No evidence, no report.\nFind 2 tagged clues first." } } ] } }
    ], "false": [ { "id": "ash-repeat", "command": "EVENT_TEXT", "args": { "text": "Ash is already on the incident log." } } ] } },
