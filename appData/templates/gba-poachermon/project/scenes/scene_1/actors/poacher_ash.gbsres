        { "id": "ash-relative", "command": "EVENT_IF_ACTOR_RELATIVE_TO_ACTOR", "args": { "actorId": "$self$", "otherActorId": "player", "operation": "left" }, "children": { "true": [ { "id": "ash-blocked", "command": "EVENT_TEXT", "args": { "text": "Ash: You boxed me in!\nThose evidence tags prove nothing!" } } ], "false": [ { "id": "ash-turn", "command": "EVENT_TEXT", "args": { "text": "Ash: I was merely relocating wire." } } ] } },
        { "id": "ash-face", "command": "EVENT_ACTOR_SET_DIRECTION", "args": { "actorId": "$self$", "direction": { "type": "direction", "value": "up" } } },
