{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/gba-studio/schemas/gbasproj.schema.json",
  "title": "GBA Studio Project",
  "type": "object",
  "required": ["schemaVersion", "name", "slug", "target", "rom", "screen", "startScene", "scenes", "assets"],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "target": { "type": "string", "const": "gba" },
    "rom": {
      "type": "object",
      "required": ["title", "gameCode", "makerCode"],
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 12 },
        "gameCode": { "type": "string", "pattern": "^[A-Z0-9]{4}$" },
        "makerCode": { "type": "string", "pattern": "^[A-Z0-9]{2}$" }
      },
      "additionalProperties": false
    },
    "screen": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "const": 240 },
        "height": { "type": "integer", "const": 160 }
      },
      "additionalProperties": false
    },
    "startScene": { "type": "string", "minLength": 1 },
    "palette": {
      "type": "object",
      "properties": {
        "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "text": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
      },
      "additionalProperties": false
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "actors", "triggers"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "background": { "type": "string" },
          "backgroundColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "message": { "type": "string" },
          "actors": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "name", "x", "y", "width", "height", "color"],
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "name": { "type": "string", "minLength": 1 },
                "x": { "type": "integer", "minimum": 0, "maximum": 239 },
                "y": { "type": "integer", "minimum": 0, "maximum": 159 },
                "width": { "type": "integer", "minimum": 1, "maximum": 240 },
                "height": { "type": "integer", "minimum": 1, "maximum": 160 },
                "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
              },
              "additionalProperties": false
            }
          },
          "triggers": { "type": "array" }
        },
        "additionalProperties": false
      }
    },
    "assets": {
      "type": "object",
      "required": ["backgrounds", "sprites", "music", "sfx"],
      "properties": {
        "backgrounds": { "type": "array" },
        "sprites": { "type": "array" },
        "music": { "type": "array" },
        "sfx": { "type": "array" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
